# syntax=docker/dockerfile:1

FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags="-s -w" -o /out/wada-relay ./cmd/wada-relay

FROM gcr.io/distroless/static-debian12:nonroot
EXPOSE 8787
ENTRYPOINT ["/wada-relay"]
CMD ["--listen", ":8787"]
COPY --from=builder /out/wada-relay /wada-relay
