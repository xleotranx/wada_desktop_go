# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS web-builder
RUN corepack enable
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM golang:1.27-bookworm AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags="-s -w" -o /out/wadad ./cmd/wadad \
 && CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags="-s -w" -o /out/wadad-term ./cmd/wadad-term \
 && CGO_ENABLED=0 GOWORK=off go build -trimpath -ldflags="-s -w" -o /out/wada ./cmd/wada

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10001 wada \
    && mkdir -p /data /workspaces /srv/wada/web \
    && chown -R wada:wada /data /workspaces /srv/wada

COPY --from=go-builder /out/wadad /usr/local/bin/wadad
COPY --from=go-builder /out/wadad-term /usr/local/bin/wadad-term
COPY --from=go-builder /out/wada /usr/local/bin/wada
COPY --from=web-builder /src/web/dist /srv/wada/web

USER wada
ENV WADA_DATA_DIR=/data
ENV WADA_WEB_DIR=/srv/wada/web
EXPOSE 6767
VOLUME ["/data", "/workspaces"]
ENTRYPOINT ["/usr/local/bin/wadad"]
CMD ["--listen", "0.0.0.0:6767", "--data-dir", "/data", "--web-dir", "/srv/wada/web"]
