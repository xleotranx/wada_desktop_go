# Copy to .env inside docker/ before running `docker compose`

# Required when enabling the `tls` Caddy profile:
WADA_RELAY_DOMAIN=relay.example.com

# Optional shared token required for daemon and client connections to wada-relay:
WADA_RELAY_TOKEN=

# The relay's own plaintext port is published on 127.0.0.1 only. Set
# WADA_RELAY_BIND=0.0.0.0 only when your own TLS proxy, not Caddy, fronts it.
WADA_RELAY_BIND=127.0.0.1
WADA_RELAY_PORT=8787

# Networks whose X-Forwarded-For names the real client (Caddy's, by default
# the private ranges), so wadad throttles failed sign-ins per client:
# WADA_RELAY_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,fc00::/7

# Optional local wadad profile settings. Without WADA_PASSWORD the daemon
# accepts only its random pairing token (`wada daemon pair`); if you set one,
# make it long and random. The daemon port is published on 127.0.0.1 unless
# WADA_DAEMON_BIND names another interface.
WADA_PASSWORD=
WADA_DAEMON_BIND=127.0.0.1
WADA_HOSTNAMES=localhost,wadad.tailnet.ts.net
WADA_RELAY_URL=wss://relay.example.com
WADA_APP_URL=https://app.wada.dev
WADA_WORKSPACES_DIR=./workspaces
